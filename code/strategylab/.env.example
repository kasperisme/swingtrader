# strategylab reads this file, then falls back to ../analytics/.env,
# so an existing swingtrader checkout works with no extra setup.

# --- price + fundamentals (required) ---
FMP_API_KEY=            # or APIKEY, same value

# --- LLM policy (required for `strategylab search`) ---
ANTHROPIC_API_KEY=
STRATEGYLAB_MODEL=claude-opus-5

# --- Supabase (REQUIRED for `social batch` / `persist`; optional elsewhere) --
# The news-impact overlay (gates.use_news / rank.w_news) is happy with just the
# pooler pair, but the priced-in batch WRITES to Supabase and its readiness gate
# needs a full connection. Two ways to give it one — either is enough:
#
#   1. One variable. Supabase Dashboard -> Project Settings -> Database ->
#      Connection string -> URI. Simplest, and the whole DSN is copy-paste.
# SUPABASE_DB_DIRECT_URL=postgresql://postgres.<ref>:<pwd>@<host>:6543/postgres
#
#   2. Three variables. SUPABASE_URL is NOT optional here — the project ref for
#      the `postgres.<ref>` pooler username is derived from it, so leaving it
#      out fails with "need SUPABASE_DB_DIRECT_URL, or SUPABASE_URL + ...".
SUPABASE_URL=                    # https://<ref>.supabase.co  (Settings -> API)
SUPABASE_DB_POOLER_HOST=         # aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PWD=                 # Settings -> Database -> password
SUPABASE_SCHEMA=swingtrader
# SUPABASE_DB_PORT=6543          # transaction pooler; 5432 for a direct connection

# --- The priced-in batch: which LLM backend the scheduled pass uses ----------
# `ollama` routes case reconstruction, decomposition and prediction generation
# through a local Ollama daemon, which also serves Ollama Cloud models under the
# same API — so `glm-5.1:cloud` needs no key here beyond `ollama signin`. This is
# what makes a full pass over ~500 eligible names affordable; the same run on a
# frontier API is four calls per ticker times several hundred tickers.
# Unset, the pipeline uses Anthropic if ANTHROPIC_API_KEY is set. `investigate`
# needs tool use and always uses Anthropic.
STRATEGYLAB_LLM_BACKEND=ollama
STRATEGYLAB_OLLAMA_MODELS=glm-5.1:cloud
# Point at another machine's daemon (the Mac mini) instead of this one:
# OLLAMA_URL=http://mac-mini.local:11434
